{
  "name": "the-snake-2",
  "version": "1.0.0",
  "description": "The Snake 2 — современная аркадная Змейка (Web + PC Electron) с уровневой прогрессией, бешенством, процедурной графикой и звуком",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/dev-electron.mjs"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.4",
    "vitest": "^3.1.1"
  }
}
